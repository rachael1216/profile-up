# Production values belong in Sites runtime environment settings.
# For local Workers, copy the needed entries to an untracked .dev.vars file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Enable only after public SMTP delivery / SMS provider setup and real delivery checks.
AUTH_EMAIL_ENABLED=false
AUTH_SMS_ENABLED=false
AUTH_SMS_DAILY_LIMIT=25
# If CAPTCHA is enabled in Supabase, configure its Turnstile site key here.
TURNSTILE_SITE_KEY=
